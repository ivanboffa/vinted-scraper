# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, or self-hosted).
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# true for managed cloud Postgres, false only for local instances without SSL
DB_SSL=true

# ── Scraper tuning ────────────────────────────────────────────────────────
CONCURRENCY=5           # simultaneous in-flight requests
REQUEST_DELAY=0.8       # seconds between requests, per worker

# ── Scheduler intervals, in hours (worker mode only) ──────────────────────
SCRAPE_INTERVAL_H=2
STATUS_INTERVAL_H=3
SOLD_INTERVAL_H=12

# ── Status-check targeting ────────────────────────────────────────────────
CHECK_LIMIT=5000        # max articles verified per run
OLDEST_FIRST=false      # true = backlog recovery, false = newest first
FRESH_ONLY=false        # true = only articles seen within FRESH_HOURS
FRESH_HOURS=48
MIN_AGE_HOURS=0         # skip articles newer than this many hours

# ── Retention ─────────────────────────────────────────────────────────────
RETENTION_DAYS=7        # delete still-active articles older than this; 0 disables

# ── Catalog scope ─────────────────────────────────────────────────────────
# Case-insensitive prefix match on the category path.
EXCLUDE_CATEGORIES=bambini,elettronica,casa,intrattenimento,animali
